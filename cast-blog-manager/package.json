{
  "name": "cast-blog-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset-password": "tsx scripts/reset-admin-password.ts",
    "typecheck": "tsc --noEmit",
    "line:image": "tsx scripts/generate-rich-menu-image.mts",
    "line:setup": "tsx scripts/setup-rich-menu.mts",
    "e2e": "tsx e2e/smoke.mts",
    "e2e:permissions": "tsx e2e/permissions.mts",
    "e2e:all": "npm run e2e && npm run e2e:permissions && npm run e2e:draft",
    "docs:overview": "tsx scripts/build-overview-pdf.mts",
    "e2e:draft": "tsx e2e/draft.mts",
    "mock:anthropic": "tsx scripts/mock-anthropic.mts",
    "docs:shots": "tsx scripts/capture-doc-shots.mts",
    "docs:spec": "tsx scripts/build-spec-pdf.mts",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "docs:simulate": "tsx scripts/simulate-reminder-volume.mts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.19.3",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "playwright": "^1.62.0",
    "postcss": "^8.5.24",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "postcss": "^8.5.24",
    "sharp": "^0.35.3"
  }
}

# =============================================================
# cast-blog-manager 環境変数サンプル
# -------------------------------------------------------------
# このファイルをコピーして .env を作成し、各値を実際の値に
# 置き換えてください。
#
#   cp .env.example .env
#
# ※ .env / .env.local は .gitignore で除外されています。
#    APIキーや認証情報は絶対にコミットしないでください。
# ※ 初期管理者は環境変数では作成しません。
#    初回起動時に /setup 画面（ユーザーが0件のときだけ有効）から作成します。
# =============================================================

# -------------------------------------------------------------
# PostgreSQL 接続文字列（開発・本番とも PostgreSQL を使用）
#   Neon（推奨）: ダッシュボードの Connection String を貼り付け
#   例（Neon）    : postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
#   例（ローカル）: postgresql://postgres:password@localhost:5432/cast_blog_manager
# -------------------------------------------------------------
DATABASE_URL="postgresql://postgres:password@localhost:5432/cast_blog_manager"

# -------------------------------------------------------------
# マイグレーション用の直結 URL。
# Neon などでプール接続（pgbouncer）を使う場合、DATABASE_URL には
# プール経由の URL を、こちらには直結 URL を設定してください。
# プールを使わない場合は DATABASE_URL と同じ値で構いません。
# -------------------------------------------------------------
DIRECT_DATABASE_URL="postgresql://postgres:password@localhost:5432/cast_blog_manager"

# -------------------------------------------------------------
# アプリの公開 URL。
# CSRF の Origin 照合と、招待・パスワード再設定リンクの生成に使います。
#   開発: http://localhost:3000 / 本番: https://your-app.vercel.app
# -------------------------------------------------------------
APP_URL="http://localhost:3000"

# -------------------------------------------------------------
# LINE Messaging API のチャネルアクセストークン
# キャストへの更新リマインド送信に使用します。
# LINE Developers コンソールの対象チャネルから取得してください。
# -------------------------------------------------------------
LINE_CHANNEL_ACCESS_TOKEN="your-line-channel-access-token"

# -------------------------------------------------------------
# LINE Messaging API のチャネルシークレット
# Webhook の署名検証に使用します（Webhook の唯一の認可手段です）。
# -------------------------------------------------------------
LINE_CHANNEL_SECRET="your-line-channel-secret"

# -------------------------------------------------------------
# cron エンドポイント（/api/cron/tick）を保護するシークレット
# GitHub Actions / Vercel Cron からの呼び出しの認可に使います。
#   生成例: openssl rand -hex 32
# -------------------------------------------------------------
CRON_SECRET="your-cron-secret-here"

# -------------------------------------------------------------
# LINE Push の月間送信上限（未設定時は 180）
# LINE 無料プランの月200通に対する安全マージンです。
# 上限に達した送信は SKIPPED_QUOTA として記録され、翌月に自然回復します。
# -------------------------------------------------------------
LINE_MONTHLY_PUSH_LIMIT="180"

# =============================================================
# cast-blog-manager 環境変数サンプル（設計 v4）
# -------------------------------------------------------------
# このファイルをコピーして .env を作成し、各値を実際の値に
# 置き換えてください。
#
#   cp .env.example .env
#
# ※ .env / .env.local は .gitignore で除外されています。
#    APIキーや認証情報は絶対にコミットしないでください。
# ※ 初期管理者は環境変数では作成しません。初回起動時に
#    /setup 画面（User が 0 件のときのみ有効）から作成します。
# =============================================================

# -------------------------------------------------------------
# PostgreSQL 接続文字列（開発・本番とも PostgreSQL を使用）
#   Neon（推奨）: ダッシュボードの Connection String をそのまま貼り付け
#   例（Neon）  : postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
#   例（ローカル）: postgresql://user:password@localhost:5432/cast_blog_manager
# -------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/cast_blog_manager"

# -------------------------------------------------------------
# NextAuth.js のセッション暗号化に使用する秘密鍵
#   生成例: openssl rand -base64 32
# -------------------------------------------------------------
NEXTAUTH_SECRET="your-random-secret-here"

# -------------------------------------------------------------
# アプリの公開 URL（NextAuth のコールバック等に使用）
#   開発: http://localhost:3000 / 本番: https://your-app.vercel.app
# -------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"

# -------------------------------------------------------------
# LINE Messaging API のチャネルアクセストークン
# キャストへの更新リマインド送信・連携通知に使用
# LINE Developers コンソールの対象チャネルから取得
# -------------------------------------------------------------
LINE_CHANNEL_ACCESS_TOKEN="your-line-channel-access-token"

# -------------------------------------------------------------
# LINE Messaging API のチャネルシークレット
# Webhook の署名検証に使用（LINE Developers コンソールから取得）
# -------------------------------------------------------------
LINE_CHANNEL_SECRET="your-line-channel-secret"

# -------------------------------------------------------------
# cron エンドポイント（/api/cron/tick）保護用のシークレット
# GitHub Actions / Vercel Cron からのリクエストの認可に使用
#   生成例: openssl rand -hex 32
# -------------------------------------------------------------
CRON_SECRET="your-cron-secret-here"

# -------------------------------------------------------------
# LINE Push 送信の月間上限（既定 180）
# LINE 無料プランの月 200 通に対して安全マージンを確保する。
# 上限に達した送信は SKIPPED_QUOTA としてログに記録される
# -------------------------------------------------------------
LINE_MONTHLY_PUSH_LIMIT="180"

# =============================================================
# cast-blog-manager 環境変数サンプル
# -------------------------------------------------------------
# このファイルをコピーして .env（または .env.local）を作成し、
# 各値を実際の値に置き換えてください。
#
#   cp .env.example .env.local
#
# ※ .env / .env.local は .gitignore で除外されています。
#    APIキーや認証情報は絶対にコミットしないでください。
# =============================================================

# -------------------------------------------------------------
# データベース接続文字列
# 開発時は SQLite を利用する想定です。
#   例（SQLite）      : file:./dev.db
#   例（PostgreSQL）  : postgresql://user:password@localhost:5432/cast_blog_manager
# -------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# -------------------------------------------------------------
# NextAuth.js のセッション暗号化に使用する秘密鍵
# 十分に長いランダム文字列を設定してください。
#   生成例: openssl rand -base64 32
# -------------------------------------------------------------
NEXTAUTH_SECRET="your-random-secret-here"

# -------------------------------------------------------------
# LINE Messaging API のチャネルアクセストークン
# LINE Developers コンソールの対象チャネルから取得します。
# キャストへのブログ更新リマインド通知などに使用する想定です。
# -------------------------------------------------------------
LINE_CHANNEL_ACCESS_TOKEN="your-line-channel-access-token"

# -------------------------------------------------------------
# LINE Messaging API のチャネルシークレット
# Webhook 署名検証などに使用します。
# LINE Developers コンソールの対象チャネルから取得します。
# -------------------------------------------------------------
LINE_CHANNEL_SECRET="your-line-channel-secret"
